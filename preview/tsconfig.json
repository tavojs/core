{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@tavojs/core",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
