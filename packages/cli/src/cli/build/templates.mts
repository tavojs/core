import { escapeTemplateLiteral } from "../utils/format.mjs";
import { toPosixPath } from "../utils/path.mjs";
import type { ClientAssetPlan } from "../types.mjs";

export const BUILD_CONFIG_GLOBAL_KEY = "@tavojs/core/config/build-value";

export function createSsrEntrySource({ pagesDir, assetPlan }: { pagesDir: string; assetPlan: ClientAssetPlan }): string {
  return [
    'import { createNodeRequestHandler, createPagesRuntimeAsync, renderPagesResponseFromRuntimeAsync } from "@tavojs/core/server";',
    "",
    "function sanitizeProductionHead(head) {",
    "  if (typeof head !== \"string\" || head.length === 0) {",
    "    return \"\";",
    "  }",
    "  return head",
    "    .replace(/<script\\b[^>]*type=[\"']module[\"'][^>]*src=[\"']\\/src\\/[^\"']+[\"'][^>]*><\\/script>/gi, \"\")",
    "    .replace(/<script\\b[^>]*src=[\"']\\/src\\/[^\"']+[\"'][^>]*><\\/script>/gi, \"\")",
    "    .trim();",
    "}",
    "",
    `const discoveredModules = import.meta.glob("/${toPosixPath(pagesDir).replace(/^\/+/, "")}/**/*.{js,jsx,ts,tsx}");`,
    "const modules = Object.fromEntries(",
    "  Object.entries(discoveredModules).map(([file, loader]) => {",
    "    const wrapped = async () => await loader();",
    "    wrapped.__tavo_loader__ = true;",
    "    return [file, wrapped];",
    "  })",
    ");",
    'const configLoaders = import.meta.glob(["/tavo.config.ts"]);',
    "const configLoader = Object.values(configLoaders)[0];",
    `const injectedConfig = globalThis[Symbol.for(${JSON.stringify(BUILD_CONFIG_GLOBAL_KEY)})];`,
    "const loadedConfigModule = injectedConfig === undefined",
    "  ? await configLoader?.()",
    "  : { default: injectedConfig };",
    "if (injectedConfig === undefined && loadedConfigModule?.default?.[Symbol.for('@tavojs/core/config/defined')] !== true) {",
    "  throw new Error('tavo config: tavo.config.ts must default-export defineConfig({...}).');",
    "}",
    "const loadedConfig = loadedConfigModule.default;",
    "const resolvedOptions = loadedConfig.ssr ?? {};",
    `const generatedHead = \`${escapeTemplateLiteral(
      assetPlan.sharedCss.map((file) => `<link rel="stylesheet" href="/${file}">`).join("")
    )}\`;`,
    `const productionAssets = ${JSON.stringify({
      clientEntryScript: assetPlan.clientEntryScript,
      moduleCss: assetPlan.moduleCss
    })};`,
    "const options = {",
    "  ...resolvedOptions,",
    "  modules: resolvedOptions.modules ?? modules,",
    "  plugins: loadedConfig.plugins,",
    "  __tavoProductionAssets: productionAssets,",
    "  document: {",
    "    ...(resolvedOptions.document ?? {}),",
    "    unsafeHeadHtml: `${sanitizeProductionHead(resolvedOptions.document?.unsafeHeadHtml ?? \"\")}${generatedHead}`",
    "  },",
    "  images: resolvedOptions.images",
    "};",
    "const runtimePromise = createPagesRuntimeAsync(options.modules, options);",
    "",
    "function isDynamicRoutePath(pathname) {",
    "  return pathname.split('/').some((segment) => segment.startsWith(':') || segment.startsWith('*'));",
    "}",
    "",
    "function encodeStaticSegment(value) {",
    "  return encodeURIComponent(String(value));",
    "}",
    "",
    "function buildStaticPath(routePath, params) {",
    "  if (routePath === '/') {",
    "    return '/';",
    "  }",
    "  const segments = routePath.split('/').filter(Boolean);",
    "  const out = [];",
    "  for (const segment of segments) {",
    "    if (segment.startsWith('*') && !segment.startsWith('*?')) {",
    "      const name = segment.slice(1) || 'all';",
    "      const value = params[name] ?? (segment === '*' ? params['*'] : undefined);",
    "      if (value === undefined || value === '') {",
    "        return null;",
    "      }",
    "      out.push(...String(value).split('/').filter(Boolean).map(encodeStaticSegment));",
    "      continue;",
    "    }",
    "    if (segment.startsWith('*?')) {",
    "      const value = params[segment.slice(2)];",
    "      if (value !== undefined && value !== '') {",
    "        out.push(...String(value).split('/').filter(Boolean).map(encodeStaticSegment));",
    "      }",
    "      continue;",
    "    }",
    "    if (segment.startsWith(':?')) {",
    "      const value = params[segment.slice(2)];",
    "      if (value !== undefined && value !== '') {",
    "        out.push(encodeStaticSegment(value));",
    "      }",
    "      continue;",
    "    }",
    "    if (segment.startsWith(':')) {",
    "      const value = params[segment.slice(1)];",
    "      if (value === undefined || value === '') {",
    "        return null;",
    "      }",
    "      out.push(encodeStaticSegment(value));",
    "      continue;",
    "    }",
    "    out.push(segment);",
    "  }",
    "  return out.length === 0 ? '/' : `/${out.join('/')}`;",
    "}",
    "",
    "export async function prerenderStaticPages() {",
    "  const runtime = await runtimePromise;",
    "  const entries = [];",
    "  const diagnostics = [];",
    "  for (const route of runtime.routes) {",
    "    await runtime.loadRouteModules(route);",
    "    if (!route.cache.static || route.cache.revalidate !== null) {",
    "      continue;",
    "    }",
    "    if (isDynamicRoutePath(route.path)) {",
    "      if (typeof route.generateStaticParams !== 'function') {",
    "        diagnostics.push(`Skipped ${route.path}: dynamic static route is missing generateStaticParams().`);",
    "        continue;",
    "      }",
    "      const paramsList = await route.generateStaticParams();",
    "      for (const params of paramsList ?? []) {",
    "        const pathname = buildStaticPath(route.path, params ?? {});",
    "        if (pathname) {",
    "          const response = await renderPagesResponseFromRuntimeAsync(runtime, pathname, options);",
    "          if (!response.redirect && response.status < 400) {",
    "            entries.push({ pathname, html: response.html, status: response.status });",
    "          } else {",
    "            diagnostics.push(`Skipped ${pathname}: prerender returned status ${response.status}.`);",
    "          }",
    "        }",
    "      }",
    "      continue;",
    "    }",
    "    const response = await renderPagesResponseFromRuntimeAsync(runtime, route.path, options);",
    "    if (!response.redirect && response.status < 400) {",
    "      entries.push({ pathname: route.path, html: response.html, status: response.status });",
    "    } else {",
    "      diagnostics.push(`Skipped ${route.path}: prerender returned status ${response.status}.`);",
    "    }",
    "  }",
    "  return { entries, diagnostics };",
    "}",
    "",
    "export async function getRouteBuildModes() {",
    "  const runtime = await runtimePromise;",
    "  await Promise.all(runtime.routes.map((route) => runtime.loadRouteModules(route)));",
    "  return runtime.routes.map((route) => {",
    "    const mode = route.renderMode === 'csr'",
    "      ? 'CSR'",
    "      : route.cache.static",
    "        ? route.cache.revalidate === null ? 'SSG' : 'ISR'",
    "        : 'SSR';",
    "    return { path: route.path, mode };",
    "  });",
    "}",
    "",
    "export const nodeHandler = createNodeRequestHandler(options, runtimePromise);",
    "export default nodeHandler;",
    ""
  ].join("\n");
}

export function createPreviewServerSource(): string {
  return [
    'import fs from "node:fs/promises";',
    'import os from "node:os";',
    'import path from "node:path";',
    'import { fileURLToPath } from "node:url";',
    'import { loadServerEnv } from "@tavojs/core/server";',
    'import http from "node:http";',
    "",
    "const __dirname = path.dirname(fileURLToPath(import.meta.url));",
    'const projectRoot = path.resolve(__dirname, "../../..");',
    'process.env.NODE_ENV ||= "production";',
    'loadServerEnv({ root: projectRoot, mode: process.env.NODE_ENV || "production" });',
    'const { nodeHandler } = await import("./entry.mjs");',
    'const clientRoot = path.resolve(__dirname, "../client");',
    'const host = process.env.HOST || "127.0.0.1";',
    'const port = Number(process.env.PORT || 4174);',
    'const monitorToken = process.env.TAVO_MONITOR_TOKEN || "";',
    'const serverUrl = `http://${host}:${port}`;',
    "const startedAt = Date.now();",
    "const securityHeaders = { \"X-Content-Type-Options\": \"nosniff\", \"Referrer-Policy\": \"strict-origin-when-cross-origin\", \"Permissions-Policy\": \"camera=(), microphone=(), geolocation=()\", \"X-Frame-Options\": \"SAMEORIGIN\" };",
    "const monitorState = { requestCount: 0, inflight: 0, errorCount: 0, staticAssetHits: 0, appHits: 0, lastRequestAt: null, lastRenderDurationMs: null, totalRenderDurationMs: 0, maxRenderDurationMs: 0, routeHits: Object.create(null) };",
    "function contentTypeForFilePath(filePath) {",
    "  const extension = path.extname(filePath).toLowerCase();",
    "  switch (extension) {",
    "    case \".js\":",
    "    case \".mjs\":",
    "      return \"text/javascript; charset=utf-8\";",
    "    case \".css\":",
    "      return \"text/css; charset=utf-8\";",
    "    case \".html\":",
    "      return \"text/html; charset=utf-8\";",
    "    case \".json\":",
    "      return \"application/json; charset=utf-8\";",
    "    case \".webmanifest\":",
    "      return \"application/manifest+json; charset=utf-8\";",
    "    case \".svg\":",
    "      return \"image/svg+xml\";",
    "    case \".png\":",
    "      return \"image/png\";",
    "    case \".jpg\":",
    "    case \".jpeg\":",
    "      return \"image/jpeg\";",
    "    case \".gif\":",
    "      return \"image/gif\";",
    "    case \".ico\":",
    "      return \"image/x-icon\";",
    "    case \".woff\":",
    "      return \"font/woff\";",
    "    case \".woff2\":",
    "      return \"font/woff2\";",
    "    default:",
    "      return \"application/octet-stream\";",
    "  }",
    "}",
    "function cacheControlForFilePath(filePath) {",
    "  const relative = path.relative(clientRoot, filePath);",
    "  const segments = relative.split(path.sep);",
    "  return segments[0] === \"assets\"",
    "    ? \"public, max-age=31536000, immutable\"",
    "    : \"no-cache\";",
    "}",
    "function isMonitorAuthorized(req) {",
    "  if (!monitorToken) return false;",
    "  const expected = `Bearer ${monitorToken}`;",
    "  return req.headers.authorization === expected;",
    "}",
    "function safePathSegments(pathname) {",
    "  const segments = pathname.split(\"/\").filter(Boolean);",
    "  const out = [];",
    "  for (const segment of segments) {",
    "    let decoded;",
    "    try {",
    "      decoded = decodeURIComponent(segment);",
    "    } catch {",
    "      return null;",
    "    }",
    "    if (!decoded || decoded === \".\" || decoded === \"..\" || decoded.includes(\"/\") || decoded.includes(\"\\\\\")) {",
    "      return null;",
    "    }",
    "    out.push(decoded);",
    "  }",
    "  return out;",
    "}",
    "function resolveAssetPaths(url) {",
    "  const segments = safePathSegments(url.pathname);",
    "  if (!segments) {",
    "    return [];",
    "  }",
    "  if (segments.length === 0) {",
    "    return [];",
    "  }",
    "  const candidates = [",
    "    path.resolve(clientRoot, ...segments),",
    "    path.resolve(clientRoot, ...segments, \"index.html\")",
    "  ];",
    "  return candidates.filter((resolved) => resolved === clientRoot || resolved.startsWith(`${clientRoot}${path.sep}`));",
    "}",
    "function collectMonitorPayload() {",
    "  const memory = process.memoryUsage();",
    "  const cpu = process.cpuUsage();",
    "  return {",
    "    server: { url: serverUrl, mode: \"production-ssr\", pid: process.pid, uptimeSeconds: process.uptime(), port, host },",
    "    requests: {",
    "      total: monitorState.requestCount,",
    "      inflight: monitorState.inflight,",
    "      errors: monitorState.errorCount,",
    "      staticAssetHits: monitorState.staticAssetHits,",
    "      appHits: monitorState.appHits,",
    "      averageRenderDurationMs: monitorState.requestCount > 0 ? Number((monitorState.totalRenderDurationMs / monitorState.requestCount).toFixed(2)) : 0,",
    "      lastRenderDurationMs: monitorState.lastRenderDurationMs,",
    "      maxRenderDurationMs: monitorState.maxRenderDurationMs,",
    "      lastRequestAt: monitorState.lastRequestAt ? new Date(monitorState.lastRequestAt).toISOString() : null,",
    "      topRoutes: Object.entries(monitorState.routeHits).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([pathname, hits]) => ({ pathname, hits }))",
    "    },",
    "    process: { rss: memory.rss, heapUsed: memory.heapUsed, heapTotal: memory.heapTotal, external: memory.external, cpuUserMicros: cpu.user, cpuSystemMicros: cpu.system, loadAverage: os.loadavg() },",
    "    timestamp: new Date().toISOString(),",
    "    startedAt: new Date(startedAt).toISOString()",
    "  };",
    "}",
    "const server = http.createServer(async (req, res) => {",
    '  const url = new URL(req.url || "/", "http://localhost");',
    "  if (url.pathname === \"/_tavo/monitor\") {",
    "    if (!isMonitorAuthorized(req)) {",
    "      res.writeHead(404, securityHeaders);",
    "      res.end(\"Not found\");",
    "      return;",
    "    }",
    "    res.writeHead(200, { ...securityHeaders, \"Content-Type\": \"application/json; charset=utf-8\" });",
    "    res.end(JSON.stringify(collectMonitorPayload(), null, 2));",
    "    return;",
    "  }",
    "  monitorState.requestCount += 1;",
    "  monitorState.inflight += 1;",
    "  monitorState.lastRequestAt = Date.now();",
    "  monitorState.routeHits[url.pathname] = (monitorState.routeHits[url.pathname] ?? 0) + 1;",
    "  const started = Date.now();",
    "  const assetPaths = resolveAssetPaths(url);",
    "  try {",
    "    for (const assetPath of assetPaths) {",
    "      const stat = await fs.stat(assetPath).catch(() => null);",
    "      if (stat?.isFile()) {",
    "        const body = await fs.readFile(assetPath);",
    "        monitorState.staticAssetHits += 1;",
    "        monitorState.lastRenderDurationMs = 0;",
    "        res.writeHead(200, {",
    "          ...securityHeaders,",
    "          \"Content-Type\": contentTypeForFilePath(assetPath),",
    "          \"Cache-Control\": cacheControlForFilePath(assetPath),",
    "          \"Content-Length\": String(body.byteLength)",
    "        });",
    "        res.end(body);",
    "        monitorState.inflight -= 1;",
    "        return;",
    "      }",
    "    }",
    "  } catch {}",
    "  try {",
    "    monitorState.appHits += 1;",
    "    await nodeHandler(req, res);",
    "    const durationMs = Date.now() - started;",
    "    monitorState.lastRenderDurationMs = durationMs;",
    "    monitorState.totalRenderDurationMs += durationMs;",
    "    monitorState.maxRenderDurationMs = Math.max(monitorState.maxRenderDurationMs, durationMs);",
    "  } catch (error) {",
    "    monitorState.errorCount += 1;",
    "    if (!res.headersSent) {",
    "      res.writeHead(500, { ...securityHeaders, \"Content-Type\": \"text/plain; charset=utf-8\" });",
    "    }",
    "    if (!res.writableEnded) {",
    "      res.end(\"Internal Server Error\");",
    "    }",
    "    console.error(\"[tavo preview:ssr] request failed\", error);",
    "  } finally {",
    "    monitorState.inflight = Math.max(0, monitorState.inflight - 1);",
    "  }",
    "});",
    "server.on(\"error\", (error) => {",
    "  console.error(`[tavo preview:ssr] failed to start on ${serverUrl}`);",
    "  console.error(error);",
    "  process.exitCode = 1;",
    "});",
    "server.listen(port, host, () => {",
    "  console.log(`[tavo preview:ssr] running at ${serverUrl}`);",
    "});",
    ""
  ].join("\n");
}
